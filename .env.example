# Database Connection
# Supports standard PostgreSQL (Local, Supabase, Neon, RDS, Docker, etc.)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rentaride?schema=public"

# Authentication
JWT_SECRET="rentaride-secure-jwt-secret-key-super-safe-random-phrase-32-chars-min"
NEXTAUTH_SECRET="rentaride-nextauth-secret-super-safe"
NEXTAUTH_URL="http://localhost:3000"

# Storage (Optional - falls back to local data URLs / realistic images if not provided)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BUSINESS_NAME="RentaRide"
NEXT_PUBLIC_CURRENCY="USD"
